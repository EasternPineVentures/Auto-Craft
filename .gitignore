# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- AutoCraft runtime artifacts -----------------------------------------
# Captures and run records are generated locally and must never be committed.
data/captures/*
!data/captures/.gitkeep
data/runs/*
!data/runs/.gitkeep

# Local configuration overrides (autocraft.example.toml is the tracked template)
autocraft.toml

# Local tooling caches
.impeccable/

# --- Editors / OS --------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
